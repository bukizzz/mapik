# Konfiguracija servera
PORT=3001
HOST=0.0.0.0

# Vremenska ograničenja za čitanje, pisanje i neaktivne veze servera (u sekundama)
SERVER_READ_TIMEOUT=60
SERVER_WRITE_TIMEOUT=600
SERVER_IDLE_TIMEOUT=120
SERVER_GRACEFUL_SHUTDOWN_TIMEOUT=10

# Identifikator podređenog čvora
IS_SLAVE=false

# Vremenska zona
TZ=Asia/Shanghai

# Konfiguracija autentifikacije je obavezna, koristi se za zaštitu administrativnog API-ja i UI interfejsa
AUTH_KEY=sk-123456

# Konfiguracija baze podataka - podrazumevano se ne popunjava, koristi se SQLite u ./data/MAPIK.db
# Primer za MySQL:
# DATABASE_DSN=root:123456@tcp(mysql:3306)/MAPIK?charset=utf8mb4&parseTime=True&loc=Local
# Primer za PostgreSQL:
# DATABASE_DSN=postgres://postgres:123456@postgres:5432/MAPIK?sslmode=disable

# Konfiguracija Redis-a - podrazumevano se ne popunjava, koristi se memorijsko skladište
# REDIS_DSN=redis://redis:6379/0

# Broj istovremenih zahteva
MAX_CONCURRENT_REQUESTS=100

# CORS konfiguracija
ENABLE_CORS=true
ALLOWED_ORIGINS=*
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*
ALLOW_CREDENTIALS=false

# Konfiguracija logovanja
LOG_LEVEL=info
LOG_FORMAT=text
LOG_ENABLE_FILE=true
LOG_FILE_PATH=./data/logs/app.log
